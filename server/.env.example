PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/veda_glow
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/veda_glow
MONGODB_URI=mongodb://127.0.0.1:27017/veda_glow

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret-32-chars-minimum
JWT_EXPIRES_IN=7d

# Admin Authentication (set these for admin access)
ADMIN_EMAIL=replace_with_bcrypt_hash_generated_from_admin_password.com
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash_generated_from_admin_password

# Admin Session Configuration
ADMIN_SESSION_SECRET=replace-with-another-long-random-secret-32-chars-minimum
ADMIN_SESSION_TTL_HOURS=24
ADMIN_COOKIE_NAME=vedaglow_admin_session

# Frontend Origin (for CORS)
# Development: http://localhost:5173
# Production: https://your-domain.com
FRONTEND_ORIGIN=http://localhost:5173

# Optional: Sentry DSN for backend error tracking
SENTRY_DSN=

# Razorpay Keys — https://dashboard.razorpay.com/app/keys
# Development: Use Test Keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=test_secret_XXXXXXXXXXXXXXXX
# Production: Use Live Keys
# RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
# RAZORPAY_KEY_SECRET=live_secret_XXXXXXXXXXXXXXXX

# Webhook secret — set in Razorpay dashboard under Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET=webhook_secret_from_razorpay_dashboard

