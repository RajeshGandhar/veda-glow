# Frontend Configuration
# Copy this file to .env.local (for development) or use environment variables in production

# Backend API URL
# Development: http://localhost:5000/api
# Production: https://your-domain.com/api
VITE_API_URL=http://localhost:5000/api

# ⚠️  RAZORPAY KEYS
# For DEVELOPMENT: Use Test Keys from https://dashboard.razorpay.com/app/keys (Test tab)
# For PRODUCTION: Use Live Keys from https://dashboard.razorpay.com/app/keys (Live tab)
# 
# Test key example (development only):
VITE_RAZORPAY_KEY=rzp_test_XXXXXXXXXXXXXXXX
# 
# Production key example (live only):
# VITE_RAZORPAY_KEY=rzp_live_XXXXXXXXXXXXXXXX

# Optional: Sentry DSN for error tracking and performance monitoring
# Get your DSN from https://sentry.io/projects/
# Format: https://[key]@[project-id].ingest.sentry.io/[id]
VITE_SENTRY_DSN=

# Optional: Google Analytics 4 Measurement ID
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: WhatsApp Business Number
VITE_WHATSAPP_NUMBER=919058964964

